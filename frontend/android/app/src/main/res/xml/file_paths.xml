<?xml version="1.0" encoding="utf-8"?>
<!-- What the share sheet may hand to another app: only the app's own cache folder, where
     lib/mobile.js writes a backup export just before sharing it. The app shares nothing from
     shared storage, so that is not exposed. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="." />
    <!-- Where the camera app writes a photo taken for "What's here?": the app's own private folder. -->
    <external-files-path name="captures" path="Pictures" />
</paths>
